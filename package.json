{
  "name": "shallot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "keygen": "bun scripts/generate-exit-key.ts",
    "dev:local": "bun scripts/local-stack.ts",
    "dev:debug": "bun scripts/local-stack.ts --inspect",
    "benchmark": "bun benchmarks/run.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test packages/e2e/tst/gateway.test.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "concurrently": "^10.0.5",
    "typescript": "latest"
  }
}
